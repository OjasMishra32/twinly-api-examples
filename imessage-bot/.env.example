# Copy this file to .env and fill it in. Never commit .env.

# The webhook signing secret: Twinly app ▸ Settings ▸ Developer API ▸ Webhook ▸ Show secret.
TWINLY_WEBHOOK_SECRET=

# Where the bot listens. Your tunnel (cloudflared or ngrok) points at this port.
PORT=8787

# "sample" makes up a forecast (works offline). "open-meteo" uses real weather
# from Open-Meteo's free API, no key needed.
WEATHER_SOURCE=sample
